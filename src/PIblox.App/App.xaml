<Application x:Class="PIblox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#A56BFF"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4BD4FF"/>
        <SolidColorBrush x:Key="WindowBrush" Color="#060815"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#14172B"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#202044"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#929BB9"/>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F6F7FF"/>
            <Setter Property="Background" Value="#262445"/>
            <Setter Property="BorderBrush" Value="#625A91"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0D1125"/>
            <Setter Property="Foreground" Value="#F6F7FF"/>
            <Setter Property="BorderBrush" Value="#39456F"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#101529"/>
            <Setter Property="Foreground" Value="#F6F7FF"/>
            <Setter Property="BorderBrush" Value="#273451"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E7E9F7"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#8B5CF6"/>
            <Setter Property="Background" Value="#303653"/>
        </Style>
    </Application.Resources>
</Application>
