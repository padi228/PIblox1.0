<Window x:Class="PIblox.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PIblox" Height="650" Width="980" MinHeight="560" MinWidth="820" Background="#0D1020" Foreground="#F2F3FF">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock Text="PIblox" FontSize="32" FontWeight="Bold" Foreground="#A99BFF"/>
      <TextBlock Text="Roblox launcher · local app detection" Foreground="#A9AEC8" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#17192B" CornerRadius="18" Padding="14" Margin="0,0,18,0">
        <StackPanel>
          <TextBlock Text="NAVIGATION" Foreground="#868DAF" FontWeight="Bold" Margin="4,6,4,14"/>
          <Button Content="Home" Click="Home_Click" Margin="0,0,0,8" Padding="12" Background="#26294A" Foreground="White"/>
          <Button Content="Diagnostics" Click="Diagnostics_Click" Margin="0,0,0,8" Padding="12" Background="#26294A" Foreground="White"/>
          <Button Content="Settings" Click="Settings_Click" Padding="12" Background="#26294A" Foreground="White"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Quick launch" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Border Background="#17192B" CornerRadius="18" Padding="20" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Roblox Player" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlayerStatus" Text="Checking installation…" Foreground="#A9AEC8" Margin="0,6,0,12"/>
            <Button x:Name="PlayerButton" Content="Launch Roblox" Click="Player_Click" Padding="12" Background="#7764FF" Foreground="White" FontWeight="Bold"/>
          </StackPanel>
        </Border>
        <Border Background="#17192B" CornerRadius="18" Padding="20" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Roblox Studio" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="StudioStatus" Text="Checking installation…" Foreground="#A9AEC8" Margin="0,6,0,12"/>
            <Button x:Name="StudioButton" Content="Launch Studio" Click="Studio_Click" Padding="12" Background="#4C91FF" Foreground="White" FontWeight="Bold"/>
          </StackPanel>
        </Border>
        <Border Background="#17192B" CornerRadius="18" Padding="20">
          <StackPanel>
            <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="DiagnosticsText" Text="Press Diagnostics to generate a local report." TextWrapping="Wrap" Foreground="#A9AEC8" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="PIblox · early scaffold · local-only" Foreground="#777E9D" Margin="0,18,0,0"/>
  </Grid>
</Window>
