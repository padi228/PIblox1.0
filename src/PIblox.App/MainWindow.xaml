<Window x:Class="PIblox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIblox" Height="850" Width="1320" MinHeight="740" MinWidth="1060" Background="#060815"
        Foreground="#F4F5FF" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PIblox neon atmosphere: layered gradients and soft glow fields -->
        <Border CornerRadius="28" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#060815" Offset="0"/>
                    <GradientStop Color="#141039" Offset="0.48"/>
                    <GradientStop Color="#071D47" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="620" Height="400" Canvas.Left="360" Canvas.Top="-170" Opacity="0.45">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#9B39FF" Offset="0"/><GradientStop Color="#4930B8" Offset="0.4"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="55"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="780" Height="360" Canvas.Left="500" Canvas.Top="390" Opacity="0.42">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#006CFF" Offset="0"/><GradientStop Color="#3034C7" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="440" Height="280" Canvas.Left="-180" Canvas.Top="460" Opacity="0.34">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8B22FF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="48"/></Ellipse.Effect>
            </Ellipse>
        </Canvas>


        <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="24" Padding="16" Margin="0,0,14,0" BorderBrush="#554C86" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D1C3A" Offset="0"/>
                    <GradientStop Color="#11182C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,18">
                    <Border Width="44" Height="44" CornerRadius="14" Background="#7757E9" Margin="0,0,0,10"><TextBlock Text="P" FontSize="25" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PIblox" FontSize="27" FontWeight="Bold" Foreground="#F4F5FF"/>
                    <TextBlock Text="YOUR ROBLOX HUB" FontSize="10" FontWeight="Bold" Foreground="#8E9BCE" Margin="2,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,20,4,4">
                    <TextBlock Text="PIblox · 1.0" Foreground="#707B9F" FontSize="11"/>
                    <TextBlock Text="Локальный режим" Foreground="#707B9F" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="МЕНЮ" Foreground="#707B9F" FontSize="10" FontWeight="Bold" Margin="4,0,0,10"/>
                    <Button x:Name="HomeNavButton" Content="⌂   Главная" Click="HomeNav_Click" HorizontalContentAlignment="Left" Background="#4B347E" BorderBrush="#A78BFA" Margin="0,0,0,5"/>
                    <Button x:Name="DiscoverNavButton" Content="⌕   Поиск игр" Click="DiscoverNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,5"/>
                    <Button x:Name="PerformanceNavButton" Content="▥   Производительность" Click="PerformanceNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,5"/>
                    <Button x:Name="CallNavButton" Content="◉   PI Call" Click="CallNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,5"/>
                    <Button x:Name="SettingsNavButton" Content="⚙   Настройки" Click="SettingsNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,5"/>
                    <Button x:Name="DiagnosticsNavButton" Content="☷   Диагностика" Click="DiagnosticsNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,5"/>
                    <Border Height="1" Background="#303858" Margin="4,18,4,16"/>
                    <Button Content="Открыть Roblox" Click="OpenRobloxWebsite_Click" HorizontalContentAlignment="Left" Background="#242447" BorderBrush="#53538A"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" Margin="6,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescription" Text="Быстрый запуск Roblox Player и Studio" Foreground="#929BB9" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#201D3B" BorderBrush="#554C86" BorderThickness="1" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="#AFA6FF" FontSize="12"/>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="6,0,0,0">
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="22" Padding="20" Margin="0,0,0,12" Background="#201C42" BorderBrush="#665BA6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Аккаунт Roblox" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AccountConnectionStatus" Text="Вход через сайт — пока без OAuth-подключения к PIblox" Foreground="#929BB9" FontSize="12" Margin="0,5,0,0"/>
                            <TextBlock Text="PIblox не получает и не сохраняет пароль или cookies." Foreground="#7884A8" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Войти на Roblox ↗" Click="ConnectRoblox_Click" Background="#8B5CF6" BorderBrush="#A78BFA" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" CornerRadius="24" Padding="26" Margin="0,0,0,14" BorderBrush="#514B90" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#30215E" Offset="0"/>
                            <GradientStop Color="#12426B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ТВОЯ ИГРОВАЯ ПЛАТФОРМА" FontSize="26" FontWeight="Bold" Foreground="#F4F0FF"/>
                            <TextBlock Text="Запускай Roblox и Studio одним нажатием. Поиск, избранное и настройки — без лишних экранов." Foreground="#D0D5F4" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="✦" FontSize="68" FontWeight="Black" Foreground="#A89BFF" VerticalAlignment="Center" Margin="24,0,14,0"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Background="#19172F" CornerRadius="18" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Открыть игру" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Название, ID или ссылка Roblox." Foreground="#929BB9" FontSize="12" Margin="0,4,0,12"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Найти" Click="HomeSearch_Click" Background="#8B5CF6" BorderBrush="#A78BFA" Margin="8,0,0,0"/>
                                    <TextBox x:Name="HomeSearchBox" ToolTip="Название, ID или ссылка" KeyDown="SearchBox_KeyDown"/>
                                </DockPanel>
                                <TextBlock Text="Результаты открываются на официальном Roblox." Foreground="#7884A8" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#19182F" CornerRadius="18" Padding="17" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PLAYER" Foreground="#8D95B7" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Roblox" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                    <TextBlock x:Name="PlayerStatus" Text="Поиск установки…" Foreground="#929BB9" FontSize="11" Margin="0,0,0,12"/>
                                    <Button x:Name="PlayerButton" Content="Запустить" Click="LaunchPlayer_Click" Background="#7768E8" BorderBrush="#8E82FF"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111827" CornerRadius="16" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="STUDIO" Foreground="#8D95B7" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Studio" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                    <TextBlock x:Name="StudioStatus" Text="Поиск установки…" Foreground="#929BB9" FontSize="11" Margin="0,0,0,12"/>
                                    <Button x:Name="StudioButton" Content="Открыть Studio" Click="LaunchStudio_Click" Background="#0891B2" BorderBrush="#38BDF8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border Background="#1E1B3A" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Избранное" FontSize="16" FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right" Content="Удалить" Click="RemoveFavorite_Click" Padding="9,5" Margin="6,0,0,0" FontSize="11"/>
                                    <Button DockPanel.Dock="Right" Content="＋ Добавить" Click="AddFavorite_Click" Padding="9,5" Margin="0" FontSize="11"/>
                                </DockPanel>
                                <ListBox x:Name="FavoritesList" Height="130" Margin="0,10,0,0" DisplayMemberPath="Name" MouseDoubleClick="FavoritesList_MouseDoubleClick"/>
                                <TextBlock Text="Двойной щелчок — открыть" Foreground="#7884A8" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1B1935" CornerRadius="16" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Недавние" FontSize="16" FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right" Content="Очистить" Click="ClearHistory_Click" Padding="9,5" Margin="0" FontSize="11"/>
                                </DockPanel>
                                <ListBox x:Name="HistoryList" Height="130" Margin="0,10,0,0" DisplayMemberPath="Name" MouseDoubleClick="HistoryList_MouseDoubleClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="DiscoverPage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Найди следующую игру" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="PIblox использует официальный поиск Roblox и не собирает каталог обходными методами." Foreground="#929BB9" Margin="0,6,0,18" TextWrapping="Wrap"/>
                    <Border Background="#111827" CornerRadius="18" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Поиск по названию" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Искать на Roblox" Click="DiscoverSearch_Click" Background="#7768E8" BorderBrush="#8E82FF" Margin="8,0,0,0"/>
                                <TextBox x:Name="DiscoverSearchBox" ToolTip="Например: survival horror"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#151A2D" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Открыть игру по ID или ссылке" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Открыть игру" Click="OpenGameId_Click" Background="#317FC9" BorderBrush="#4B9BFF" Margin="8,0,0,0"/>
                                <TextBox x:Name="GameIdBox" ToolTip="Числовой ID или HTTPS-ссылка roblox.com"/>
                            </DockPanel>
                            <TextBlock Text="Ссылки на сторонние сайты не открываются из этого поля." Foreground="#7884A8" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Добавить текущий запрос в избранное" Click="AddDiscoverFavorite_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="PerformancePage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Состояние системы" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Локальные показатели Windows. PIblox не меняет системные настройки." Foreground="#929BB9" Margin="0,6,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111827" CornerRadius="18" Padding="22" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ЗАГРУЗКА CPU" Foreground="#8993B7" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="CpuValueText" Text="—" FontSize="34" FontWeight="Bold" Margin="0,10,0,10"/>
                                <ProgressBar x:Name="CpuProgress" Minimum="0" Maximum="100"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#151A2D" CornerRadius="16" Padding="22" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ИСПОЛЬЗОВАНИЕ RAM" Foreground="#8993B7" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="MemoryValueText" Text="—" FontSize="34" FontWeight="Bold" Margin="0,10,0,10"/>
                                <ProgressBar x:Name="MemoryProgress" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="MemoryDetailText" Text="" Foreground="#929BB9" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#151A2D" CornerRadius="16" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Проверка соединения" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PingValueText" Text="Ещё не проверялось" Foreground="#929BB9" Margin="0,5,0,10"/>
                            <Button Content="Проверить доступность Roblox" Click="Ping_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Настройки PIblox" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Настройки хранятся локально в папке профиля Windows." Foreground="#929BB9" Margin="0,6,0,18"/>
                    <Border Background="#151A2D" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheckBox" Content="Запускать PIblox при входе в Windows"/>
                            <CheckBox x:Name="AutoUpdateCheckBox" Content="Проверять новые версии при запуске PIblox"/>
                            <TextBlock Text="Обновления проверяются через GitHub Releases. Установка выполняется только после отдельного подтверждения пользователем." Foreground="#929BB9" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Сохранить настройки" Click="SaveSettings_Click" Background="#7768E8" BorderBrush="#8E82FF"/>
                                <Button Content="Проверить обновления" Click="CheckUpdates_Click" Margin="8,3,0,3"/>
                                <Button Content="Открыть папку настроек" Click="OpenSettingsFolder_Click" Margin="8,3,0,3"/>
                                <Button Content="Экспорт настроек" Click="ExportSettings_Click" Margin="8,3,0,3"/>
                                <Button Content="Импорт настроек" Click="ImportSettings_Click" Margin="8,3,0,3"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Диагностика" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Отчёт формируется локально. Перед отправкой кому-либо проверь его содержимое." Foreground="#929BB9" Margin="0,6,0,12"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Создать отчёт" Click="GenerateReport_Click" Background="#7768E8" BorderBrush="#8E82FF"/>
                        <Button Content="Копировать" Click="CopyReport_Click" Margin="8,3,0,3"/>
                        <Button Content="Сохранить TXT" Click="SaveReport_Click" Margin="8,3,0,3"/>
                    </WrapPanel>
                </StackPanel>
                <TextBox x:Name="DiagnosticsBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#0C1024" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
