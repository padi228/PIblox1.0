<Window x:Class="PIblox.App.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIblox Network" Width="900" Height="700" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#080B1A" Foreground="#F4F5FF"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Border CornerRadius="26" BorderBrush="#514B90" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#151331" Offset="0"/>
                    <GradientStop Color="#101B37" Offset="0.58"/>
                    <GradientStop Color="#071A35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PIblox Network" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Защищённое сетевое подключение для Windows" Foreground="#A5AECE" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#25214C" BorderBrush="#6559AE" BorderThickness="1"
                        CornerRadius="12" Padding="13,8" VerticalAlignment="Center">
                    <TextBlock x:Name="NetworkStatusBadge" Text="Проверка…" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#171B34" BorderBrush="#34365F" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="VPN ENGINE" Foreground="#929BB9" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="EngineStatusText" Text="Поиск…" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                        <TextBlock Text="WireGuard for Windows" Foreground="#929BB9" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#171B34" BorderBrush="#34365F" BorderThickness="1" CornerRadius="17" Padding="17" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="СЕТЕВОЙ АДАПТЕР" Foreground="#929BB9" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="AdapterStatusText" Text="Проверка…" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                        <TextBlock Text="Локальная диагностика" Foreground="#929BB9" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#171B34" BorderBrush="#34365F" BorderThickness="1" CornerRadius="17" Padding="17" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VPN-ТУННЕЛЬ" Foreground="#929BB9" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TunnelStatusText" Text="Не настроен" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                        <TextBlock Text="Нужен серверный профиль" Foreground="#929BB9" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#11182D" BorderBrush="#34365F" BorderThickness="1" CornerRadius="18" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Первый запуск" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="PIblox Network использует официальный WireGuard-клиент. Для реального соединения понадобится конфигурация от собственного сервера или сервиса, который разрешил тебе подключение."
                                   Foreground="#A5AECE" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,18,0,15">
                        <Button Content="Обновить диагностику" Click="Refresh_Click" Background="#7257DB" BorderBrush="#9B87FF" Margin="0,0,8,0"/>
                        <Button Content="Сохранить отчёт" Click="SaveReport_Click" Margin="0,0,8,0"/>
                        <Button Content="Открыть WireGuard" Click="OpenWireGuard_Click" Margin="0,0,8,0"/>
                        <Button Content="Официальная установка" Click="OpenInstallPage_Click"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Отчёт диагностики" Foreground="#C4B5FD" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="DiagnosticsTextBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#090E20" Foreground="#D8DDF5" BorderBrush="#303858"
                                 FontFamily="Consolas" FontSize="12" Padding="12" Height="250"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="PIblox пока не меняет маршруты Windows, DNS или системные сетевые настройки. Диагностика безопасна и не требует прав администратора."
                               Foreground="#8793B4" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="PIblox Network · Foundation preview" Foreground="#7884A8" FontSize="11" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Закрыть" Click="Close_Click" Padding="18,8"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
